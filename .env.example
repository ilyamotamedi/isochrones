# Copy this file to `.env.local` and paste in your Mapbox PUBLIC token.
#
#   cp .env.example .env.local
#
# Get one at https://console.mapbox.com/account/access-tokens/
#
# It MUST be a public token (starts with `pk.`). Public tokens are designed to be
# shipped to the browser — mapbox-gl cannot work without one client-side.
#
# NEVER put a secret token (`sk.`) here. Secret tokens carry write scopes and this
# value is bundled into the client build, where anyone can read it.
#
# Before deploying, add a URL restriction to the token in the Mapbox console so it
# only works from your domain. Note that a restricted token rejects requests with
# HTTP 403, which is a confusing symptom — check restrictions first when debugging.
VITE_MAPBOX_TOKEN=pk.your_token_here

# ---------------------------------------------------------------------------
# Firebase (optional)
#
# Unlike the Mapbox token, these are NOT secrets. Firebase web config is public
# by design — it identifies the project on every request, and access is
# controlled by security rules and API key restrictions, not by hiding it.
# They live here so dev and prod can point at different projects.
#
# Leave them blank and Analytics simply never starts: `src/analytics` checks for
# apiKey and measurementId before it loads anything.
#
# Find them in the Firebase console under Project settings → Your apps → SDK
# setup and configuration.
#
# Note that Analytics ALSO requires production mode and explicit consent, so
# filling these in is necessary but not sufficient. See README.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

